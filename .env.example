# 本地开发配置。生产服务器请使用 deploy/alei-blog.env.example。

# 管理员登录密码。运行 npm run admin:password 可补齐本地 .env；至少 12 位。
# 轮换密码和后台入口：npm run admin:password -- --reset
ADMIN_PASSWORD=

# 后台入口随机路径。首次运行 npm run admin:password 时会自动生成并显示访问地址。
# 可用 openssl rand -hex 24 生成
ADMIN_PATH=

# 博客数据库连接串。使用已有数据库时手动填写；留空时，本地 npm run db:setup 会配置默认数据库并写入。
DATABASE_URL=

# 可选：仅当 db:setup 需要在已有 PostgreSQL 实例中创建博客账号和数据库时填写。
# 该账号需要创建角色和数据库的权限；db:setup 成功后会从 .env 移除此项。
# PG_ADMIN_URL=postgresql://postgres:URL_ENCODED_PASSWORD@127.0.0.1:5432/postgres

# 可选：OpenAI 兼容 AI 服务的密钥，仅由服务器读取；服务地址在后台“模型配置”中设置。
AI_PROVIDER_API_KEY=
# Artificial Analysis 数据接口密钥；后台保存的密钥优先于此项。
AA_API_KEY=

# 上传和 AI 生成的图片、音频等文件目录。生产环境应设为代码目录以外的持久化绝对路径。
CMS_MEDIA_DIRECTORY=.local/media

# HOST 控制开发/Node 服务监听地址；PORT 仅用于 npm start，npm run dev 的端口固定为 3000。
HOST=127.0.0.1
PORT=3000

# 仅当服务位于可信反向代理后面，且代理会覆盖转发头时设为 1；本地直连保持 0。
VINEXT_TRUST_PROXY=0

# 邮箱加密密钥由程序首次使用时自动生成并存入数据库，无需配置。
# 可选：原样填写邮箱授权码，优先于后台保存的授权码；修改后重启服务。
SMTP_AUTH_CODE=
# 仅在可信代理覆盖 X-Real-IP 时启用；直连使用共享限流桶。
CONTACT_TRUST_PROXY=0
# 默认启用通知任务；隔离测试时设为 0。
CONTACT_MAIL_WORKER_ENABLED=1

# 可选：仅当 AI 服务的出站请求需要代理时设置。NO_PROXY 用于指定绕过代理的地址。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1

# 可选：pg_dump/pg_restore 不在 PATH 中时，填写包含这两个程序的目录。
# POSTGRES_BIN=C:\Program Files\PostgreSQL\18\bin

# 可选：本地备份输出目录和完成备份的保留天数；留空时使用 .local/backups 且不自动清理。
# 生产备份路径和保留天数由 deploy/alei-blog-backup.service 设置。
# CMS_BACKUP_DIRECTORY=.local/backups
# CMS_BACKUP_RETENTION_DAYS=14
