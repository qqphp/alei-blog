# 运行 npm run admin:password 生成本地 .env，密码至少 12 位。
ADMIN_PASSWORD=

# PostgreSQL 博客专用账号连接串。本地建库后由 npm run db:setup 写入。
DATABASE_URL=
# 首次建库前临时填写；成功后 db:setup 会移除此项。
# PG_ADMIN_URL=postgresql://postgres:密码@127.0.0.1:5432/postgres

# Teamorouter / OpenAI 兼容中转站密钥，仅供服务端使用。
TEAMOROUTER_KEY=

# Artificial Analysis Data API 密钥；服务端请求使用 x-api-key，不会发送到浏览器。
# 后台“AI 大模型设置 → API 接口设置”保存的密钥优先于此环境变量。
AA_API_KEY=

# 本机开发默认 .local/media，生产使用持久化绝对路径。
CMS_MEDIA_DIRECTORY=.local/media
HOST=127.0.0.1
PORT=3000
# 仅在应用通过可信的本机 Nginx 代理访问时启用。
VINEXT_TRUST_PROXY=0
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1
# POSTGRES_BIN=C:\Program Files\PostgreSQL\18\bin
# CMS_BACKUP_DIRECTORY=.local/backups
# CMS_BACKUP_RETENTION_DAYS=14
