{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node scripts/start-local.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:setup": "node --env-file=.dev.vars scripts/setup-postgres.mjs",
    "db:migrate": "node --env-file=.dev.vars scripts/migrate-postgres.mjs",
    "db:seed-missing": "node --env-file=.dev.vars --import tsx scripts/seed-missing-sections.mjs",
    "db:import-d1": "node --env-file=.dev.vars scripts/import-d1.mjs",
    "db:backup": "node --env-file=.dev.vars scripts/backup-postgres.mjs",
    "admin:password": "node scripts/admin-password.mjs",
    "typecheck": "tsc --noEmit",
    "test:cms": "node --env-file=.dev.vars --import tsx scripts/test-granular.mjs",
    "test:audit-regressions": "node --env-file=.dev.vars --import tsx scripts/test-audit-regressions.mjs",
    "test:admin-ui": "node --import tsx scripts/test-admin-ui.mjs",
    "test:content-order": "node --import tsx scripts/test-content-order.mjs",
    "test:admin-granular-ui": "node --import tsx scripts/test-admin-granular-ui.mjs",
    "test:pond-motion": "node --import tsx scripts/test-pond-motion.mjs",
    "test:pond-lifecycle": "node --import tsx scripts/test-pond-lifecycle.mjs",
    "test:film-ai": "node --import tsx scripts/test-film-ai.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@uiw/react-md-editor": "4.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "1.31.0",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "react-server-dom-webpack": "19.2.6",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "undici": "7.29.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "happy-dom": "20.14.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
