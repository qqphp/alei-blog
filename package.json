{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-vinext.mjs",
    "predev": "node scripts/prepare-markdown-assets.mjs",
    "prebuild": "node scripts/prepare-markdown-assets.mjs",
    "dev": "node --env-file-if-exists=.env node_modules/vinext/dist/cli.js dev",
    "build": "node --env-file-if-exists=.env node_modules/vinext/dist/cli.js build",
    "start": "node --env-file-if-exists=.env scripts/start-node.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-postgres.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-postgres.mjs",
    "db:seed-missing": "node --env-file-if-exists=.env --import tsx scripts/seed-missing-sections.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/backup-postgres.mjs",
    "admin:password": "node scripts/admin-password.mjs",
    "typecheck": "tsc --noEmit",
    "test:cms": "node --env-file-if-exists=.env --import tsx scripts/test-granular.mjs",
    "test:self-hosting": "node --env-file-if-exists=.env scripts/test-self-hosting.mjs",
    "test:server-fetch": "node --import tsx scripts/test-server-fetch.mjs",
    "test:dependencies": "node scripts/test-dependency-security.mjs",
    "test:audit-regressions": "node --env-file-if-exists=.env --import tsx scripts/test-audit-regressions.mjs",
    "test:admin-ui": "node --import tsx scripts/test-admin-ui.mjs",
    "test:markdown": "node --import tsx scripts/test-markdown.mjs",
    "test:markdown-ai": "node --import tsx scripts/test-markdown-ai.mjs",
    "test:media-upload": "node --import tsx scripts/test-media-upload.mjs",
    "test:public-pagination": "node --import tsx scripts/test-public-pagination.mjs",
    "test:content-order": "node --import tsx scripts/test-content-order.mjs",
    "test:admin-granular-ui": "node --import tsx scripts/test-admin-granular-ui.mjs",
    "test:booklist-entries-ui": "node --import tsx scripts/test-booklist-entries-ui.mjs",
    "test:contact": "node --env-file-if-exists=.env --import tsx scripts/test-contact.mjs",
    "test:contact-ui": "node --import tsx scripts/test-contact-ui.mjs",
    "test:contact-live": "node --env-file-if-exists=.env --import tsx scripts/test-contact-live.mjs",
    "test:pond-motion": "node --import tsx scripts/test-pond-motion.mjs",
    "test:pond-lifecycle": "node --import tsx scripts/test-pond-lifecycle.mjs",
    "test:film-ai": "node --import tsx scripts/test-film-ai.mjs",
    "test:aa-cache": "node --import tsx scripts/test-aa-cache.mjs",
    "test:public-remote-ui": "node --import tsx scripts/test-public-remote-ui.mjs",
    "db:init": "npm run db:migrate && npm run db:seed-missing && node --env-file-if-exists=.env scripts/prepare-media.mjs",
    "db:restore": "node --env-file-if-exists=.env scripts/restore-postgres.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "fast-glob": "file:vendor/vinext-glob",
    "github-markdown-css": "5.9.0",
    "highlight.js": "11.12.0",
    "image-size": "2.0.4",
    "imapflow": "^2.2.5",
    "ipaddr.js": "2.5.0",
    "katex": "0.16.47",
    "lucide-react": "1.31.0",
    "mdast-util-to-string": "4.0.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-server-dom-webpack": "19.2.8",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.6.0",
    "undici": "7.30.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vditor": "4.0.0",
    "vinext": "1.0.1"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "happy-dom": "20.14.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "overrides": {
    "fflate": "0.7.5",
    "vite-plugin-dynamic-import": {
      "fast-glob": "$fast-glob"
    }
  },
  "type": "module"
}
