# 由 deploy/alei-blog.service 作为 systemd 环境文件加载，安装到 /etc/alei-blog/alei-blog.env。
# 文件权限应为 root:alei-blog、0640；不要提交实际密码或密钥。

# 必填：生产 PostgreSQL 连接串。数据库账号只授予博客库所需权限，密码中的特殊字符需 URL 编码。
DATABASE_URL=postgresql://alei_blog:URL_ENCODED_PASSWORD@127.0.0.1:5432/alei_blog
# 必填：设置新的随机管理员密码，至少 12 位；不要复用本地开发密码。
ADMIN_PASSWORD=REPLACE_WITH_NEW_RANDOM_PASSWORD_AT_LEAST_12_CHARACTERS
# 必填：运行 openssl rand -hex 24 生成 48 位十六进制路径，保存好完整后台地址。
ADMIN_PATH=REPLACE_WITH_48_RANDOM_HEX_CHARACTERS

# 必填：上传和 AI 生成的图片、音频等素材持久化目录；不要放在项目构建目录中。
CMS_MEDIA_DIRECTORY=/var/lib/alei-blog/media

# 可选：OpenAI 兼容 AI 服务的密钥，仅由服务器读取；服务地址在后台“模型配置”中设置。
AI_PROVIDER_API_KEY=
# Artificial Analysis 数据接口密钥；后台设置的密钥优先于此项。
AA_API_KEY=

# 邮箱加密密钥由程序首次使用时自动生成并存入数据库，无需配置。
# 可选：原样填写邮箱授权码，优先于后台保存的授权码；修改后重启服务。
SMTP_AUTH_CODE=
# nginx 必须覆盖 X-Real-IP；外部不能直连 Node 端口。
CONTACT_TRUST_PROXY=1
CONTACT_MAIL_WORKER_ENABLED=1

# 可选：仅当 VPS 访问 AI 服务需要代理时填写；NO_PROXY 可列出绕过代理的地址。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1

# 可选：pg_dump/pg_restore 不在 PATH 中或版本不正确时，指定 PostgreSQL 18 的 bin 目录。
# POSTGRES_BIN=/usr/lib/postgresql/18/bin
# SEO 验收前保持 0；填写正式 HTTPS 根地址后，通过验收再改为 1 并重启。
SITE_URL=
SEO_INDEXABLE=0
